# ==========================================================================
#  Variables de entorno — copiá este archivo a ".env" y completá los valores
#  cp .env.example .env
# ==========================================================================

# Base de datos.
# Por defecto usa SQLite local (funciona sin instalar nada).
# Para producción, cambialo por una URL de PostgreSQL (ej. Supabase):
#   DATABASE_URL="postgresql://usuario:pass@host:5432/postgres"
DATABASE_URL="file:./dev.db"

# Contraseña del panel de administración (/admin).
# ¡Cambiala por una fuerte antes de publicar!
ADMIN_PASSWORD="cambiame123"

# API key de Claude (Anthropic) para el análisis con IA real.
# Si la dejás vacía, la app usa un análisis de respaldo automático y sigue
# funcionando. Sacá tu key en https://console.anthropic.com
ANTHROPIC_API_KEY=""

# Modelo de IA a usar (opcional).
#   claude-sonnet-5           -> equilibrio calidad/costo (por defecto)
#   claude-haiku-4-5-20251001 -> más económico
#   claude-opus-4-8           -> máxima calidad
ANTHROPIC_MODEL="claude-sonnet-5"
